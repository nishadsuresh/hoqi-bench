{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: current test file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug: sweep runner (smoke config)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_sweep.py",
            "args": [
                "--config",
                "${workspaceFolder}/configs/smoke.toml"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug: current script (with args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": "${command:pickArgs}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
